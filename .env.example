FILE_SERVER_DOMAIN=files.simovi.org

# Match these names to the static configuration of your existing Traefik.
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_DOCKER_NETWORK=traefik_proxy

# Pin to a tested official release tag or digest before production deployment.
COPYPARTY_IMAGE=copyparty/ac:latest
COPYPARTY_UID=1000
COPYPARTY_GID=1000
COPYPARTY_DATA_DIR=./data
TZ=UTC
